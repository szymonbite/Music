# Copy this file to .env and fill in what you need. Every value is optional:
# with nothing set, Earworm runs in demo mode with its built-in song catalogue.

# Port the server listens on (default 3000).
PORT=3000

# Public URL of the app. Needed in production and for the Google OAuth redirect URI.
# The redirect URI to register in Google Cloud is: <APP_URL>/api/auth/google/callback
APP_URL=http://localhost:3000

# Where the SQLite database lives (default ./data/earworm.db).
# DATABASE_PATH=./data/earworm.db

# --- YouTube Data API key (optional) ---
# Lets everyone search YouTube for songs, paste playlist links, and get
# fresh recommendations (trending music, more songs from artists you like).
YOUTUBE_API_KEY=

# --- Google OAuth client (optional) ---
# Lets people connect their YouTube Music account: import liked songs and
# playlists, mirror likes/dislikes, and save songs to a YouTube playlist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spend extra YouTube quota (100 units per call) searching for songs in your
# favourite genres when building recommendations. Default: false.
# YOUTUBE_DISCOVERY_SEARCH=false

# Max YouTube searches per day for discovery, e.g. finding songs by similar
# artists (each costs 100 of the 10,000 daily units). Default: 30.
# YOUTUBE_DAILY_SEARCH_BUDGET=30

# --- Similar artists (optional) ---
# Free Last.fm API key (https://www.last.fm/api/account/create) for better
# "similar artists". Without it Earworm uses Deezer's public API.
LASTFM_API_KEY=
# Force a provider: lastfm, deezer or off. Default: lastfm if a key is set, else deezer.
# SIMILAR_ARTISTS=deezer

# Set to true when the app is served over HTTPS (default: true if APP_URL starts with https).
# COOKIE_SECURE=false

# Set when running behind a reverse proxy (e.g. "1" for one hop, or "true").
# TRUST_PROXY=1
